# Copy to `.env` for local development (file is gitignored).
# These values substitute the ${VAR} placeholders in wrangler.template.jsonc
# when `bun run cf:config` is run (automatically before dev/build/deploy).
#
# In CI/CD the same values are supplied via GitHub Secrets/Variables — see README.

# ── Worker ────────────────────────────────────────────────────────────
# Worker name on Cloudflare (must be globally unique)
WORKER_NAME=bits-vpn-cloudflare

# ── Vars (non-sensitive, also settable as GitHub Variables) ───────────
# Remote proxy list source (proxy.txt). Use a public raw URL or your own endpoint.
PRX_BANK_URL=https://raw.githubusercontent.com/Banten-IT-Solutions/BITS-VPN-Cloudflare/main/proxy.txt
# Country bucket KV source (KV.json). Defaults to the repository raw URL.
KV_PRX_URL=https://raw.githubusercontent.com/Banten-IT-Solutions/BITS-VPN-Cloudflare/main/KV.json

# ── Routes (custom domains) ───────────────────────────────────────────
# Main custom domain — must be an active zone in your Cloudflare account
APP_DOMAIN=yuliana.my.id
# Second custom domain used for wildcard / SNI host.
# Allows SSL SAN to match this exact hostname (Universal SSL wildcard only covers one level).
# Replace with your own domain.
WC_DOMAIN=support.zoom.us.yuliana.my.id

# ── Derived (optional) ────────────────────────────────────────────────
# APP_URL overrides the smoke-test URL; otherwise derived from APP_DOMAIN.
APP_URL=https://yuliana.my.id
