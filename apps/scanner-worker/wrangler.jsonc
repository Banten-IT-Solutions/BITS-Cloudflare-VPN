{
  "name": "bits-vpn-scanner",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "PROXY_LISTS",
      "bucket_name": "bits-vpn-proxy-lists"
    }
  ],
  "vars": {
    "SOURCE_URLS": "",
    "MAX_CANDIDATES": "500",
    "MAX_CONCURRENCY": "10",
    "PROBE_TIMEOUT_MS": "2000",
    "MAX_DELAY_MS": "2000"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
