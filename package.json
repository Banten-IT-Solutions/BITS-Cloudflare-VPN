{
  "name": "vpn",
  "version": "2.0.0",
  "description": "Serverless VPN tunnel proxy on Cloudflare Workers - supports VLESS, Trojan, Shadowsocks, and VMess over WebSocket (CDN) with SNI and DoH",
  "keywords": [
    "vpn",
    "cloudflare",
    "cloudflare-workers",
    "proxy",
    "vless",
    "trojan",
    "shadowsocks",
    "vmess",
    "websocket",
    "cdn"
  ],
  "license": "MIT",
  "type": "module",
  "private": true,
  "author": {
    "name": "Banten IT Solutions",
    "email": "admin@bits.co.id",
    "url": "https://bits.co.id"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitscoid/BITS-Cloudflare-VPN.git"
  },
  "bugs": {
    "url": "https://github.com/bitscoid/BITS-Cloudflare-VPN/issues"
  },
  "homepage": "https://github.com/bitscoid/BITS-Cloudflare-VPN",
  "main": "worker.js",
  "exports": {
    ".": "./worker.js"
  },
  "files": [
    "worker.js",
    "KV.json",
    "proxy.txt",
    "raw.txt",
    "scan.ts"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "scan": "bun run scan.ts",
    "types": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.0.0"
  }
}
